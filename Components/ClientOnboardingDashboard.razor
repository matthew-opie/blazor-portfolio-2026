@using blazor_portfolio_2026.Models.Onboarding
@inject OnboardingStateService State
@inject OnboardingApiClient OnboardingApi
@inject IJSRuntime JS
@implements IDisposable

<OnboardingTutorialModal @ref="_tutorialModal"
                         Visible="_showTutorial"
                         ActiveTenant="State.ActiveTenant"
                         Documents="_indexedDocuments"
                         SampleQueries="State.SuggestedQueries"
                         IngestBadge="@State.FormatIngestBadge()"
                         CanRunQuery="@(State.IsConnected && !State.IsProcessing)"
                         OnClose="CloseTutorial"
                         OnRunSampleQuery="RunTutorialQuery" />

<OnboardingDocumentViewerModal Visible="_showDocumentViewer"
                               ActiveTenant="State.ActiveTenant"
                               Documents="_indexedDocuments"
                               InitialDocumentId="_viewerDocumentId"
                               InitialPage="_viewerPage"
                               OnClose="CloseDocumentViewer" />

<div class="onboarding-dashboard">
    <header class="dashboard-header">
        <div class="dashboard-title-block">
            <p class="dashboard-eyebrow">Institutional Client Onboarding</p>
            <h2 class="dashboard-title">Compliance Intelligence Console</h2>
            <p class="dashboard-subtitle">
                Multi-tenant policy search · hybrid retrieval · MCP compliance checks
            </p>
        </div>

        <div class="tenant-switcher">
            <div class="tenant-switcher-top">
                <label class="tenant-label" for="tenant-select">
                    <i class="fa-solid fa-shield-halved"></i> Active Tenant
                </label>
                <button type="button"
                        class="tutorial-help-btn"
                        title="Show onboarding guide"
                        @onclick="OpenTutorial">
                    <i class="fa-solid fa-circle-question"></i>
                    <span>Guide</span>
                </button>
            </div>
            <div class="tenant-switcher-row">
                <button type="button"
                        class="view-documents-btn"
                        title="Browse indexed policy PDFs"
                        disabled="@(State.ActiveTenant is null || !State.IsConnected)"
                        @onclick='() => OpenDocumentViewer()'>
                    <i class="fa-solid fa-file-pdf"></i>
                    <span>Documents</span>
                </button>
                <select id="tenant-select"
                        class="tenant-select"
                        @bind="_selectedTenantId"
                        @bind:after="OnTenantSwitched"
                        disabled="@(!State.IsConnected || State.IsProcessing)">
                    @foreach (var tenant in State.Tenants)
                    {
                        <option value="@tenant.Id">@tenant.DisplayId — @tenant.InstitutionType</option>
                    }
                </select>
            </div>
            @if (State.ActiveTenant is not null)
            {
                <div class="tenant-meta">
                    <ObTooltip Text="Document ingest status from DynamoDB INGEST#latest — PDFs chunked and embedded into this tenant's search index.">
                        <span class="meta-chip meta-chip--ingest @GetIngestBadgeClass()">@State.FormatIngestBadge()</span>
                    </ObTooltip>
                    <ObTooltip Text="DynamoDB partition key — all reads for this tenant are scoped to this partition; cross-partition access is audited in telemetry.">
                        <span class="meta-chip">PK: @State.ActiveTenant.PartitionKey</span>
                    </ObTooltip>
                    <ObTooltip Text="Isolated Qdrant vector collection — dense search never leaves this tenant's embedding index.">
                        <span class="meta-chip">@State.ActiveTenant.VectorCollection</span>
                    </ObTooltip>
                </div>
            }
        </div>
    </header>

    @if (State.IsInitializing)
    {
        <div class="status-bar status-bar--active">
            <span class="status-pulse"></span>
            <span>Connecting to onboarding API…</span>
        </div>
    }
    else if (!State.IsConnected)
    {
        <div class="status-bar status-bar--error">
            <span>Unable to connect to onboarding API. @State.ConnectionError</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(State.StatusMessage))
    {
        <div class="status-bar @(State.IsProcessing ? "status-bar--active" : "")">
            @if (State.IsProcessing)
            {
                <span class="status-pulse"></span>
            }
            <span>@State.StatusMessage</span>
        </div>
    }

    <div class="dashboard-grid">
        <section class="panel panel-chat">
            <div class="panel-header">
                <span class="panel-title"><i class="fa-solid fa-comments"></i> RAG Query Interface</span>
                <ObTooltip Text="Retrieval combines BM25 keyword search with Qdrant dense vectors, fused via reciprocal rank fusion before GPT synthesis.">
                    <span class="panel-badge">Hybrid BM25 + Dense</span>
                </ObTooltip>
            </div>

            <div class="chat-transcript" @ref="_transcriptRef">
                @for (var i = 0; i < State.Messages.Count; i++)
                {
                    var index = i;
                    var message = State.Messages[index];

                    <div class="chat-bubble chat-bubble--@message.Role.ToString().ToLowerInvariant()">
                        <div class="chat-role">@FormatRole(message.Role)</div>
                        <div class="chat-content">
                            @message.Content
                            @if (message.IsStreaming)
                            {
                                <span class="stream-cursor"></span>
                            }
                        </div>

                        @if (message.Contexts is { Count: > 0 } && !message.IsStreaming)
                        {
                            var primaryContext = message.Contexts[0];
                            var additionalContexts = message.Contexts.Skip(1).ToList();

                            <div class="context-card">
                                <div class="context-card-toolbar">
                                    <button type="button"
                                            class="context-toggle"
                                            @onclick="() => State.ToggleContextExpanded(index)">
                                        <i class="fa-solid @(message.ContextExpanded ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                        Retrieved Context@if (primaryContext.PageNumber > 0)
                                        {
                                            <text> · page @primaryContext.PageNumber</text>
                                        }
                                        <span class="context-doc">@primaryContext.DocumentId</span>
                                    </button>
                                    <button type="button"
                                            class="context-view-doc"
                                            @onclick="() => OpenDocumentViewer(primaryContext.DocumentId, primaryContext.PageNumber)">
                                        <i class="fa-solid fa-file-pdf"></i> View PDF
                                    </button>
                                </div>

                                @if (message.ContextExpanded)
                                {
                                    <RetrievedContextBody Context="primaryContext"
                                                          OnViewDocument="ViewDocumentFromContext" />
                                }
                            </div>

                            @if (additionalContexts.Count > 0)
                            {
                                <button type="button"
                                        class="context-more-toggle"
                                        @onclick="() => State.ToggleAdditionalContextsExpanded(index)">
                                    <i class="fa-solid @(message.AdditionalContextsExpanded ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                    @(message.AdditionalContextsExpanded
                                        ? "Hide additional sources"
                                        : $"{additionalContexts.Count} more source{(additionalContexts.Count == 1 ? "" : "s")}")
                                </button>

                                @if (message.AdditionalContextsExpanded)
                                {
                                    @foreach (var context in additionalContexts)
                                    {
                                        <div class="context-card context-card--secondary">
                                            <div class="context-secondary-header">
                                                <span class="context-doc">@context.DocumentId</span>
                                                @if (context.PageNumber > 0)
                                                {
                                                    <span class="retrieval-badge retrieval-badge--page">page @context.PageNumber</span>
                                                }
                                                <button type="button"
                                                        class="context-view-doc"
                                                        @onclick="() => OpenDocumentViewer(context.DocumentId, context.PageNumber)">
                                                    <i class="fa-solid fa-file-pdf"></i> View PDF
                                                </button>
                                            </div>
                                            <RetrievedContextBody Context="context"
                                                                  OnViewDocument="ViewDocumentFromContext" />
                                        </div>
                                    }
                                }
                            }
                        }
                    </div>
                }
            </div>

            <div class="sample-queries">
                <span class="sample-label">Demo queries</span>
                <div class="sample-chips">
                    @foreach (var sample in State.SuggestedQueries)
                    {
                        <button type="button"
                                class="sample-chip"
                                disabled="@(!State.IsConnected || State.IsProcessing)"
                                @onclick="() => UseSampleQuery(sample)">
                            @sample
                        </button>
                    }
                </div>
            </div>

            <form class="chat-input-row" @onsubmit="SubmitQuery" @onsubmit:preventDefault="true">
                <input class="chat-input"
                       placeholder="Ask about IPS limits, restrictions, or policy…"
                       @bind="_queryText"
                       @bind:event="oninput"
                       disabled="@(!State.IsConnected || State.IsProcessing)" />
                <button type="submit"
                        class="chat-submit"
                        disabled="@(!State.IsConnected || State.IsProcessing || string.IsNullOrWhiteSpace(_queryText))">
                    @if (State.IsProcessing)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-paper-plane"></i>
                    }
                    <span>Query</span>
                </button>
            </form>
        </section>

        <div class="dashboard-right">
            <section class="panel panel-mcp">
                <div class="panel-header">
                    <span class="panel-title"><i class="fa-solid fa-terminal"></i> MCP Tool Execution Log</span>
                    <ObTooltip Text="Compliance tools invoked over the Model Context Protocol wire protocol before the LLM answer is generated — same tools external clients (e.g. Cursor) can call directly.">
                        <span class="panel-badge panel-badge--terminal">Model Context Protocol</span>
                    </ObTooltip>
                </div>

                <div class="mcp-log">
                    @if (State.ToolLogs.Count == 0)
                    {
                        <div class="mcp-empty">
                            <i class="fa-solid fa-microchip"></i>
                            <p>Awaiting query — agent will invoke compliance tools before synthesis.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var entry in State.ToolLogs)
                        {
                            <div class="mcp-entry mcp-entry--@entry.Status.ToString().ToLowerInvariant()">
                                <div class="mcp-entry-header">
                                    <span class="mcp-time">@entry.Timestamp.LocalDateTime.ToString("HH:mm:ss.fff")</span>
                                    <span class="mcp-status mcp-status--@entry.Status.ToString().ToLowerInvariant()">
                                        @entry.Status
                                    </span>
                                    <span class="mcp-duration">@entry.DurationMs ms</span>
                                </div>
                                <div class="mcp-tool-line">
                                    <span class="mcp-prompt">&gt;</span>
                                    <code>@entry.ToolName</code><span class="mcp-args">(@entry.Parameters)</span>
                                </div>
                                <pre class="mcp-output">@entry.Output</pre>
                            </div>
                        }
                    }
                </div>
            </section>

            <section class="panel panel-telemetry">
                <div class="panel-header">
                    <span class="panel-title"><i class="fa-solid fa-chart-line"></i> Benchmarking &amp; Telemetry</span>
                    <ObTooltip Text="RAGAS faithfulness scores come from cached golden-set evals stored in DynamoDB — real benchmarks, not live heuristics on every query.">
                        <span class="panel-badge">RAGAS Suite</span>
                    </ObTooltip>
                </div>

                <div class="telemetry-body">
                    <div class="telemetry-grid">
                    <div class="metric-card metric-card--hoverable"
                         @onmouseenter='() => SetTelemetryHint("Query Embedding", "OpenAI text-embedding-3-small converts your question into a 1536-dimensional vector for dense similarity search.")'
                         @onmouseleave="ClearTelemetryHint">
                        <span class="metric-label">Query Embedding</span>
                        <span class="metric-value">@FormatLatency(State.Telemetry.EmbeddingMs)</span>
                    </div>
                    <div class="metric-card metric-card--hoverable"
                         @onmouseenter='() => SetTelemetryHint("Qdrant Dense Search", "HNSW approximate nearest-neighbor search in the active tenant Qdrant collection — returns the top 8 child chunk hits.")'
                         @onmouseleave="ClearTelemetryHint">
                        <span class="metric-label">Qdrant Dense Search</span>
                        <span class="metric-value">@FormatLatency(State.Telemetry.QdrantSearchMs)</span>
                    </div>
                    <div class="metric-card metric-card--hoverable"
                         @onmouseenter='() => SetTelemetryHint("DynamoDB Child Load", "Child chunk records loaded from DynamoDB under CHILD# sort keys — warm Lambda containers cache these between requests.")'
                         @onmouseleave="ClearTelemetryHint">
                        <span class="metric-label">DynamoDB Child Load</span>
                        <span class="metric-value">@FormatLatency(State.Telemetry.DynamoDbAssemblyMs)</span>
                    </div>
                    <div class="metric-card metric-card--hoverable"
                         @onmouseenter='() => SetTelemetryHint("Parent Assembly", "Parent chunks fetched via DynamoDB BatchGet — larger token windows that child hits roll up into for LLM context.")'
                         @onmouseleave="ClearTelemetryHint">
                        <span class="metric-label">Parent Assembly</span>
                        <span class="metric-value">@FormatLatency(State.Telemetry.ParentAssemblyMs)</span>
                    </div>
                    <div class="metric-card metric-card--hoverable"
                         @onmouseenter='() => SetTelemetryHint("Hybrid Rerank", "BM25 and dense rankings merged with reciprocal rank fusion (RRF). BM25 runs in parallel with vector search.")'
                         @onmouseleave="ClearTelemetryHint">
                        <span class="metric-label">Hybrid Rerank</span>
                        <span class="metric-value">@FormatLatency(State.Telemetry.HybridRerankMs)</span>
                    </div>
                    <div class="metric-card metric-card--highlight metric-card--hoverable"
                         @onmouseenter='() => SetTelemetryHint("RAGAS Faithfulness Score", "Offline RAGAS faithfulness benchmark — measures how grounded answers are in retrieved context. Seeded via POST /admin/eval.")'
                         @onmouseleave="ClearTelemetryHint">
                        <span class="metric-label">RAGAS Faithfulness Score</span>
                        <span class="metric-value">@FormatScore(State.EvalStatus.Faithfulness)</span>
                    </div>
                    <div class="metric-card metric-card--success metric-card--hoverable"
                         @onmouseenter='() => SetTelemetryHint("Cross-Partition Reads", "Isolation audit: counts data-plane reads and verifies none crossed tenant partition or Qdrant collection boundaries. 0% is the goal.")'
                         @onmouseleave="ClearTelemetryHint">
                        <span class="metric-label">Cross-Partition Reads</span>
                        <span class="metric-value">@FormatLeakPercent(State.Telemetry)</span>
                    </div>
                    <div class="metric-card metric-card--hoverable"
                         @onmouseenter='() => SetTelemetryHint("Retrieved Chunks", "Parent chunks passed to GPT after hybrid reranking — typically the top 2 parents form the final context window.")'
                         @onmouseleave="ClearTelemetryHint">
                        <span class="metric-label">Retrieved Chunks</span>
                        <span class="metric-value">@State.Telemetry.RetrievedChunks</span>
                    </div>
                    </div>
                    <div class="telemetry-hint-bar">
                        <span class="telemetry-hint-label @(_telemetryHintLabel is null ? "telemetry-hint-label--idle" : "")">
                            @(_telemetryHintLabel ?? "Overview")
                        </span>
                        <p class="telemetry-hint-text">@(_telemetryHint ?? State.FormatEvalHint())</p>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@code {
    private string _queryText = string.Empty;
    private ElementReference _transcriptRef;
    private TenantId _selectedTenantId = TenantId.Tenant001;
    private bool _showTutorial;
    private bool _tutorialEligibilityChecked;
    private IReadOnlyList<IndexedDocument> _indexedDocuments = [];
    private OnboardingTutorialModal? _tutorialModal;
    private string? _telemetryHint;
    private string? _telemetryHintLabel;
    private bool _showDocumentViewer;
    private string? _viewerDocumentId;
    private int _viewerPage;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += HandleStateChanged;
        await State.InitializeAsync();
        _selectedTenantId = State.ActiveTenant?.Id ?? TenantId.Tenant001;
        await RefreshIndexedDocumentsAsync();
        await TryShowTutorialOnFirstVisitAsync();
    }

    private void HandleStateChanged()
    {
        if (State.ActiveTenant is not null)
        {
            _selectedTenantId = State.ActiveTenant.Id;
            _ = RefreshIndexedDocumentsAsync();
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshIndexedDocumentsAsync()
    {
        if (State.ActiveTenant is null)
        {
            _indexedDocuments = [];
            return;
        }

        _indexedDocuments = await OnboardingApi.GetDocumentsAsync(State.ActiveTenant.Id);
    }

    private async Task TryShowTutorialOnFirstVisitAsync()
    {
        if (_tutorialEligibilityChecked || !State.IsConnected)
        {
            return;
        }

        _tutorialEligibilityChecked = true;

        var seen = await JS.InvokeAsync<bool>("onboardingPrefs.hasSeenTutorial");
        if (!seen)
        {
            _showTutorial = true;
        }
    }

    private void OpenTutorial()
    {
        _tutorialModal?.Reset();
        _showTutorial = true;
    }

    private void CloseTutorial()
    {
        _showTutorial = false;
    }

    private async Task RunTutorialQuery(string query)
    {
        _showTutorial = false;
        await State.SubmitQueryAsync(query);
    }

    private void OpenDocumentViewer(string? documentId = null, int page = 0)
    {
        _viewerDocumentId = documentId;
        _viewerPage = page;
        _showDocumentViewer = true;
    }

    private void ViewDocumentFromContext((string DocumentId, int Page) request) =>
        OpenDocumentViewer(request.DocumentId, request.Page);

    private void CloseDocumentViewer()
    {
        _showDocumentViewer = false;
        _viewerDocumentId = null;
        _viewerPage = 0;
    }

    private void SetTelemetryHint(string label, string hint)
    {
        _telemetryHintLabel = label;
        _telemetryHint = hint;
    }

    private void ClearTelemetryHint()
    {
        _telemetryHintLabel = null;
        _telemetryHint = null;
    }

    private void OnTenantSwitched()
    {
        if (State.ActiveTenant is null || _selectedTenantId == State.ActiveTenant.Id)
        {
            return;
        }

        _queryText = string.Empty;
        State.SwitchTenant(_selectedTenantId);
    }

    private async Task SubmitQuery()
    {
        var query = _queryText;
        _queryText = string.Empty;
        await State.SubmitQueryAsync(query);
    }

    private async Task UseSampleQuery(string sample)
    {
        _queryText = sample;
        await State.SubmitQueryAsync(sample);
        _queryText = string.Empty;
    }

    private static string FormatRole(ChatRole role) => role switch
    {
        ChatRole.System => "System",
        ChatRole.User => "Analyst",
        ChatRole.Assistant => "Compliance Agent",
        _ => role.ToString()
    };

    private static string FormatLatency(double ms) =>
        ms <= 0 ? "—" : $"< {Math.Max(1, (int)Math.Ceiling(ms))}ms";

    private static string FormatLeakPercent(TelemetrySnapshot telemetry) =>
        telemetry.IsIdle || telemetry.DataPlaneChecks <= 0
            ? "—"
            : $"{telemetry.CrossTenantLeakPercent:F0}%";

    private static string FormatLeakHint(TelemetrySnapshot telemetry) =>
        telemetry.IsIdle || telemetry.DataPlaneChecks <= 0
            ? "Measured per query from DynamoDB + Qdrant scope checks"
            : $"{telemetry.DataPlaneChecks} data-plane checks · 0 violations means every read stayed in tenant partition/collection";

    private static string FormatScore(double? score) =>
        score is null or <= 0 ? "—" : score.Value.ToString("F2");

    private string GetIngestBadgeClass() => State.IngestStatus.Status.ToLowerInvariant() switch
    {
        "running" => "meta-chip--running",
        "failed" => "meta-chip--error",
        "completed" => "meta-chip--success",
        _ => string.Empty
    };

    public void Dispose()
    {
        State.OnChange -= HandleStateChanged;
    }
}
