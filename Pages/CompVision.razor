@page "/cv"
@layout FullWidthLayout
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Comp Vision Playground</PageTitle>

<div class="cv-page">
    <h2 class="cv-title">Comp Vision Playground</h2>

    <div class="cv-layout">

        <!-- Left: Tools -->
        <div class="cv-panel cv-tools">
            <div class="panel-label">Tools</div>
            <div class="tag-filter-strip">
                <button class="filter-btn filter-btn--opencv @(_activeTagFilter == "opencv" ? "active" : _activeTagFilter != null ? "inactive" : "")"
                        @onclick='() => ToggleTagFilter("opencv")'>OpenCV</button>
                <button class="filter-btn filter-btn--tensorflow @(_activeTagFilter == "tensorflow" ? "active" : _activeTagFilter != null ? "inactive" : "")"
                        @onclick='() => ToggleTagFilter("tensorflow")'>TF</button>
                <button class="filter-btn filter-btn--mediapipe @(_activeTagFilter == "mediapipe" ? "active" : _activeTagFilter != null ? "inactive" : "")"
                        @onclick='() => ToggleTagFilter("mediapipe")'>MPipe</button>
            </div>
            <div class="cv-tools-scroll">
            @{
                string? _lastCategory = null;
                var _visible = _activeTagFilter == null
                    ? _algorithms
                    : _algorithms.Where(a => _tags.TryGetValue(a.Id, out var t) && t.Contains(_activeTagFilter));
            }
            @foreach (var algo in _visible)
            {
                var a = algo;
                if (a.Category != _lastCategory)
                {
                    _lastCategory = a.Category;
                    <div class="tool-category">@a.Category</div>
                }
                <div class="tool-item @(_selected.Id == a.Id ? "active" : "")"
                     @onclick="() => SelectAlgorithm(a)">
                    <button class="tool-btn">@a.Name</button>
                    @if (_tags.TryGetValue(a.Id, out var chipTags) && chipTags.Length > 0)
                    {
                        <div class="tool-tags">
                            @foreach (var tag in chipTags)
                            {
                                <span class="tag-chip" data-tag="@tag">@tag</span>
                            }
                        </div>
                    }
                </div>
            }
            </div>
            <button class="info-toggle-btn @(_infoOpen ? "active" : "")"
                    title="@(_infoOpen ? "Hide algorithm details" : "How it works")"
                    @onclick="() => _infoOpen = !_infoOpen">
                <i class="fa-solid @(_infoOpen ? "fa-angles-left" : "fa-angles-right")"></i>
                <span>@(_infoOpen ? "Hide" : "Details")</span>
            </button>
        </div>

        <!-- Info: Algorithm details panel -->
        <div class="cv-info @(_infoOpen ? "open" : "")">
            <div class="cv-info-scroll">
                <p class="algo-info-name">@_selected.Name</p>
                <div class="algo-doc">
                    @switch (_selected.Id)
                    {
                        case "passthrough":
                            <p>Each video frame is captured by calling <code>drawImage(video, …)</code> into a hidden offscreen canvas, then <code>cv.imread(canvas)</code> converts the raw pixel buffer into an OpenCV <code>Mat</code> typed <code>CV_8UC4</code> (8-bit unsigned, 4 channels: RGBA). In passthrough, that Mat is copied to the output and written to the visible canvas via <code>cv.imshow</code> without any processing.</p>
                            <p>The offscreen canvas is necessary because <code>cv.imread</code> does not accept a <code>HTMLVideoElement</code> directly; it needs a canvas whose pixel buffer can be read synchronously. Every algorithm in this app goes through this same pipeline. The processing loop runs inside <code>requestAnimationFrame</code> on the main thread, so any algorithm that takes more than roughly 16 ms will drop frames visibly.</p>
                            break;

                        case "grayscale":
                            <p>Each pixel is converted to a single luminance value using the ITU-R BT.601 luma equation: <code>Y = 0.299·R + 0.587·G + 0.114·B</code>. The weights come from the spectral sensitivity of the human visual system. The eye has far more green-sensitive M-cones than red-sensitive L-cones, and comparatively few blue-sensitive S-cones, so green carries the most perceptual weight.</p>
                            <p>OpenCV's <code>cvtColor(src, dst, COLOR_RGBA2GRAY)</code> applies those coefficients in a single pass. The output is a single-channel image, which then gets converted back to RGBA before display. HTML canvases always expect 4-channel pixel data, so the luminance value is broadcast to all three color channels with alpha fixed at 255.</p>
                            break;

                        case "invert":
                            <p>Applies a bitwise NOT to each color channel: <code>dst = 255 - src</code> per pixel. Black maps to white, white maps to black, and every intensity in between inverts symmetrically around 127.</p>
                            <p>The alpha channel has to be excluded. Applying <code>bitwise_not</code> to the full RGBA Mat would invert alpha from 255 to 0, making every pixel fully transparent and producing a black canvas. The fix is to strip alpha first (RGBA to BGR), run the inversion on the 3-channel image, then convert back (BGR to RGBA) with alpha restored to 255.</p>
                            break;

                        case "blur":
                            <p>Convolves the image with a 2D Gaussian kernel. The kernel is defined by <code>G(x,y) = (1/2πσ²) · exp(-(x²+y²)/2σ²)</code>, a rotationally symmetric bell curve that weights nearby pixels heavily and distant pixels near-zero. As a low-pass filter, it attenuates high-frequency noise while preserving broad image structure.</p>
                            <p>The 2D Gaussian is separable: <code>G(x,y) = G(x) · G(y)</code>, so OpenCV computes it as two sequential 1D convolutions rather than one 2D pass. This brings per-pixel cost from O(k²) down to O(2k) where k is the kernel size, which matters a lot for large kernels. The kernel size must be odd so there is a well-defined center pixel. When σ=0, OpenCV derives it from the kernel size automatically using <code>σ ≈ 0.3·((k-1)·0.5 - 1) + 0.8</code>.</p>
                            break;

                        case "canny":
                            <p>Canny edge detection, developed by John Canny in 1986, remains a standard reference method. It is designed around three explicit optimality criteria: low error rate (real edges only, minimal noise response), good localization (detected position close to the true edge center), and single response per edge.</p>
                            <p><strong>Sobel gradients.</strong> Two 3×3 kernels estimate the partial derivatives ∂I/∂x and ∂I/∂y at each pixel. Gradient magnitude <code>|G| = √(Gx²+Gy²)</code> gives edge strength; direction <code>θ = atan2(Gy, Gx)</code> gives orientation.</p>
                            <p><strong>Non-maximum suppression.</strong> Each pixel's gradient magnitude is compared against its two neighbors along the gradient direction, quantized to one of four angles (0°, 45°, 90°, 135°). Pixels that are not local maxima along that direction are zeroed out. This thins wide gradient ridges down to single-pixel-wide edges.</p>
                            <p><strong>Hysteresis thresholding.</strong> Two thresholds partition pixels into strong edges (above the high threshold), weak edges (between the two), and non-edges (below the low threshold). Weak pixels survive only if they are 8-connected to at least one strong pixel, which preserves edge continuity through lower-contrast regions. This is what separates Canny from a simple gradient threshold.</p>
                            break;

                        case "threshold":
                            <p>The most basic form of binary segmentation. Each pixel intensity is compared to a fixed scalar T: pixels above T become 255 (white), everything else becomes 0 (black). The image is first converted to grayscale because thresholding is a scalar operation and works on a single intensity channel.</p>
                            <p>Global thresholding is effective when the scene has a clearly bimodal intensity histogram with a clean separation between foreground and background. It falls apart under spatially uneven lighting, where the right threshold varies across the image. Adaptive thresholding handles that by computing a local threshold per region. Otsu's method is another practical alternative: it automatically selects T to maximize the between-class intensity variance, which is equivalent to finding the valley between the two peaks in the histogram.</p>
                            break;

                        case "colorDetect":
                            <p>Detects pixels matching a target color in HSV space and draws a bounding box around the best matching region.</p>
                            <p><strong>Why HSV.</strong> In RGB, chromatic and luminance information are tangled across all three channels. The same red object looks very different in bright light versus shadow. HSV separates hue (the chromatic angle), saturation (color purity), and value (brightness) into independent channels. Changes in illumination mostly shift V while H stays relatively stable, making HSV much more reliable for color-based thresholding than raw RGB.</p>
                            <p><strong>Hue wrap-around.</strong> OpenCV compresses the standard 360° hue circle to [0, 179] to fit in an 8-bit integer. Red falls near both ends of this range, around H=0 and H=179. When the target hue plus or minus the tolerance crosses either boundary, the implementation runs two separate <code>inRange</code> calls and combines them with <code>bitwise_or</code>.</p>
                            <p><strong>Morphological cleanup.</strong> The binary mask from <code>inRange</code> is dilated with a large elliptical kernel (3 iterations) to merge nearby pixel clusters into solid blobs, then lightly eroded once to remove isolated noise. Dilation first preserves fragmented detections on striped or partially occluded objects that a conventional open operation would destroy.</p>
                            <p><strong>Region selection.</strong> <code>findContours</code> extracts the connected components. Instead of taking the largest region by pixel count, the implementation picks the contour with the highest fill density (contour area divided by bounding rectangle area). That selects the region where the target color is most uniformly packed, rather than a large sparse blob where matching pixels happen to span a wide area.</p>
                            break;

                        case "objectDetect":
                            <p>Tracks a user-captured region using normalized cross-correlation template matching. At each frame, the stored template is slid across the source image to find the location that matches it most closely.</p>
                            <p><strong>Normalized cross-correlation.</strong> At each candidate position (x, y), <code>cv.matchTemplate</code> with <code>TM_CCOEFF_NORMED</code> computes:</p>
                            <p><code>R(x,y) = ΣΣ(T'·S') / √(ΣΣT'² · ΣΣS'²)</code></p>
                            <p>where T' and S' are zero-mean versions of the template and source patch. This is the Pearson correlation coefficient applied to image patches, giving a score in [-1, 1] where 1.0 is a perfect match. Normalization makes the score invariant to global brightness changes between the template and the current frame.</p>
                            <p><strong>Scale search.</strong> The template is resized to up to 5 discrete scale factors. A smaller template matches a larger (closer) object; a larger template matches a smaller (farther) one. The correct approach is to resize the image pyramid rather than the template, which avoids accumulating interpolation artifacts on the reference patch, but template resizing is simpler and works acceptably for modest depth changes.</p>
                            <p><strong>Rotation search.</strong> At each scale, the template is rotated via an affine transform from <code>getRotationMatrix2D</code> and <code>warpAffine</code>. The output canvas expands to fit the rotated template without clipping: <code>nw = |W·cosθ| + |H·sinθ|</code>, <code>nh = |W·sinθ| + |H·cosθ|</code>. The translation in the rotation matrix is adjusted to keep the image centered. The best combination of scale and angle wins by highest correlation score.</p>
                            <p>Each <code>matchTemplate</code> call runs in O(W·H·tw·th) time. At maximum settings the grid can be 65 combinations per frame, which is where performance degrades. Template matching also has no concept of object class; it is looking for the exact captured patch, so illumination changes or occlusion can cause it to lose the target.</p>
                            break;

                        case "handTrack":
                            <p>MediaPipe Hands detects 21 3D landmarks per hand from a single RGB frame. The 21 keypoints cover the wrist, four joints per finger (MCP, PIP, DIP, tip), and the thumb CMC, spanning the full kinematic chain of the hand. Each detected hand also returns a handedness label. Right hands are drawn in green, left hands in cyan, so both are distinguishable when two hands appear simultaneously.</p>
                            <p><strong>Two-stage pipeline.</strong> Detection runs in two stages. First, a palm detector (BlazePalm) locates hand bounding boxes in the full image at low resolution. BlazePalm is a single-shot detector optimized to find the relatively featureless rectangular region of the palm, which is easier to detect reliably than individual fingers. Second, each detected palm is cropped, aligned, and passed into a landmark regression network that outputs the 21 keypoints. Once a hand is found, subsequent frames feed the pre-aligned crop directly into regression, skipping BlazePalm entirely until the hand is lost, which is what gives tracking its low per-frame cost.</p>
                            <p><strong>Full vs Lite model.</strong> The Full model uses a wider regression network that handles extreme wrist angles, partially occluded fingers, and hands at the frame edge more reliably. The Lite model is a pruned version that runs faster at the cost of accuracy on those difficult cases. Both run via TF.js on the WebGL backend. Switching between them or changing the max-hands count disposes the current detector and creates a new one, which takes a few seconds.</p>
                            <p>The returned keypoints include x, y, and z coordinates. The z value is relative depth normalized to the wrist, with smaller values closer to the camera. Only x and y are used for the 2D overlay here. Individual keypoint scores are not always populated by the TF.js runtime; the confidence slider primarily controls whether whole-hand detections below the overall hand score are shown.</p>
                            break;

                        case "poseEstimate":
                            <p>MoveNet is a single-person pose estimation model from Google that detects 17 anatomical keypoints: nose, eyes, ears, shoulders, elbows, wrists, hips, knees, and ankles. Each keypoint is returned as pixel coordinates plus a confidence score between 0 and 1. The skeleton overlay draws lines along anatomically plausible joint pairs and marks each detected point with a circle.</p>
                            <p><strong>Architecture.</strong> MoveNet uses a MobileNetV2 encoder paired with a Feature Pyramid Network decoder. The prediction heads output one heatmap per keypoint (indicating the probability distribution over spatial locations), a set of local offset vectors for sub-pixel refinement within each heatmap cell, and per-edge displacement fields that associate keypoints belonging to the same person. The model runs at 192x192 (Lightning) or 256x256 (Thunder); input frames are resized to that resolution before inference.</p>
                            <p><strong>Lightning vs Thunder.</strong> Lightning is tuned for speed, typically running at 50 or more frames per second on a mid-range GPU via WebGL. Thunder uses more filters and a larger input, trading some speed for higher accuracy on occluded joints and fast-moving limbs. Switching between them disposes the current detector and loads a new one, which takes a few seconds while the model weights download and compile to WebGL shaders.</p>
                            <p>Inference runs asynchronously so the video feed stays smooth. The <code>estimatePoses</code> call fires once per render frame; while TF.js is computing on the GPU, the draw loop continues overlaying the most recently completed skeleton. This produces a small lag between movement and the overlay, which is unavoidable when inference takes longer than a single frame interval.</p>
                            break;

                        case "faceLandmarks":
                            <p>MediaPipe Face Mesh detects 468 facial landmarks per face, or 478 with refinement enabled. The points form a dense mesh covering the full face surface. This implementation draws feature contours color-coded by region: green for the face oval and eyes, cyan for eyebrows, orange for the nose, pink for the lips, and blue iris rings when refine is on.</p>
                            <p><strong>Two-stage pipeline.</strong> A face detector first locates bounding boxes in the full frame. Each detected face is then cropped, normalized, and passed through a landmark regression network that outputs 468 3D points in the local crop coordinate system. Those are projected back to image pixel coordinates for rendering. Because the regressor works on a pre-aligned crop rather than the full image, it is lightweight enough to run every frame after the initial face detection fires.</p>
                            <p><strong>Refined landmarks.</strong> With Refine enabled the model outputs 478 points. The extra 10 are iris keypoints: one center and four cardinal ring points per eye, arranged as a circle. These enable gaze direction estimation and virtual pupil effects. Refine also improves accuracy along the lip boundary. Toggling it disposes the current detector and loads a new one, which takes a few seconds.</p>
                            <p>Inference fires asynchronously each frame. The returned keypoints include a z coordinate encoding relative depth within the face (values closer to zero are nearer the camera), but only x and y are used for the 2D contour overlay. Max Faces controls how many detections the model returns per frame; each additional face adds proportionally to inference time.</p>
                            break;

                        case "bodySegment":
                            <p>BodyPix classifies each pixel as one of 24 body-part regions or background. The 24 classes cover both sides of each area: face, upper and lower arms, hands, torso, upper and lower legs, and feet. Each region is overlaid with a distinct color blended over the original video, making the full body silhouette and its internal structure visible in real time.</p>
                            <p><strong>Architecture.</strong> BodyPix uses a MobileNetV1 backbone with a fully convolutional head that simultaneously produces a person/background mask and a per-pixel part classification. The backbone operates at a downsampled resolution controlled by the output stride (16 here), then the segmentation maps are bilinearly upsampled to match the input canvas size. The model is loaded with a width multiplier of 0.75 and 2-byte weight quantization, which halves memory use with minimal accuracy loss compared to the full-precision weights.</p>
                            <p><strong>Threshold.</strong> The segmentation threshold sets the minimum probability required to label a pixel as belonging to a person before the part classifier assigns it a region. Lower values capture more of the body silhouette, including soft edges around hair and loose clothing, but also introduce background bleed. Higher values produce a tighter mask that may leave gaps over low-contrast skin or dark clothing against similar backgrounds.</p>
                            <p>Inference runs asynchronously each frame so the video stays smooth. The result is a flat <code>Int32Array</code> with one index per pixel: -1 for background, 0 to 23 for body parts. The compositing loop reads this array and linearly interpolates between the original pixel color and the region color at the specified opacity. Background pixels (index -1) are left untouched, so the original video shows through wherever no person is detected.</p>
                            break;

                        case "depthEstimate":
                            <p>Estimates per-pixel depth from a single RGB image using ARPortraitDepth, a neural network trained by Apple on large portrait datasets. Because it uses a learned model rather than stereo cameras or active depth sensors, it produces a relative depth map — values represent distance ordering rather than metric distances. The output is colorized with a blue-to-red gradient where blue is near and red is far, then blended over the original video feed.</p>
                            <p><strong>Monocular depth cues.</strong> The model infers depth from the same visual cues the human visual system uses: relative scale (smaller objects appear farther away), perspective convergence, texture gradient, and occlusion. For portrait subjects, it also leverages body priors learned during training — the model has a statistical expectation of how people look at various distances and poses, which helps it produce sharper depth boundaries around the person silhouette than a purely geometry-based approach.</p>
                            <p><strong>Normalization.</strong> The raw output is linearly rescaled per-frame so the nearest point maps to 0 and the farthest maps to 1. This maximizes visual contrast regardless of how close or far the subject is. The Invert toggle flips the color direction if the near/far assignment feels wrong for a given scene. Blend controls how much of the colorized depth replaces the original frame — at 0.5 the depth is a translucent overlay; at 1.0 it replaces the video entirely.</p>
                            <p>Inference runs asynchronously so the video stays smooth. As with all monocular depth methods, the output is relative and scale-ambiguous: two scenes with identical visual geometry but different absolute scales are indistinguishable to the model. It works best on portrait-oriented scenes with a clear foreground subject.</p>
                            break;

                        case "emotionDetect":
                            <p>Detects faces and classifies each into seven emotional categories — happy, sad, angry, fearful, disgusted, surprised, and neutral — using two sequential neural networks from face-api.js, a library built on TensorFlow.js. The face detector runs first to locate bounding boxes, then the expression network runs on each cropped face patch to produce a probability distribution over the seven emotions.</p>
                            <p><strong>Detection stage.</strong> A TinyFaceDetector network locates face bounding boxes. TinyFaceDetector is a compact single-shot network that is significantly faster than the Viola-Jones cascade used in the Face Detection algorithm, at the cost of requiring a GPU-capable runtime. It processes the full frame at a fixed input resolution (416x416 here) and outputs boxes with confidence scores.</p>
                            <p><strong>Expression stage.</strong> The expression network is a small MobileNet-based classifier that takes an aligned and normalized face crop as input and outputs seven softmax probabilities. Because the probabilities sum to one, the model always picks a most-likely emotion even for neutral faces — high neutral probability indicates the model found no strong evidence for any of the other six states.</p>
                            <p>The top three predicted emotions are displayed below each face box, labeled with their probability as a percentage. The face box is colored with the dominant emotion's assigned color. Inference is asynchronous and fire-and-forget: detection continues at GPU-limited frame rate while the video feed remains smooth. The confidence threshold filters detections before they are drawn — if the face detector scores a region below the threshold it is not passed to the expression network at all.</p>
                            break;

                        case "cocoSsd":
                            <p>Runs MobileNet SSD via TensorFlow.js, a neural network trained on the 80-class COCO dataset. The model runs entirely in the browser using WebGL for GPU acceleration. Inference fires asynchronously so the video feed continues at full frame rate while detections update as fast as the GPU allows, typically 5-15 fps on a mid-range desktop.</p>
                            <p><strong>MobileNet backbone.</strong> MobileNet replaces the standard convolutions of a full CNN with depthwise separable convolutions. Each standard conv is split into a depthwise conv (one filter per input channel, zero cross-channel mixing) followed by a pointwise 1x1 conv (mixes channels). The depthwise step costs <code>Dk²M</code> operations and the pointwise step costs <code>DM²</code>, versus <code>Dk²M²</code> for a standard conv. For a 3x3 kernel and 512 channels this is roughly 8x fewer multiply-adds, which is what makes MobileNet fast enough to run on constrained hardware.</p>
                            <p><strong>SSD detection head.</strong> Single Shot Detector attaches prediction heads at multiple feature map layers with different spatial resolutions. Coarser feature maps (large receptive fields) handle large objects; finer maps (small receptive fields) handle small ones. At each spatial location, the head predicts bounding box offsets relative to a set of default anchor boxes with fixed aspect ratios and scales, plus a class probability distribution over all 80 categories plus background. This is different from a two-stage detector (like Faster R-CNN) which first proposes regions and then classifies them; SSD does both in a single forward pass.</p>
                            <p><strong>Box format.</strong> COCO-SSD returns detections in <code>[x, y, width, height]</code> format in pixel coordinates of the input frame, along with a class name string and a score. The confidence slider maps directly to the <code>minScore</code> parameter in <code>model.detect()</code>. Non-maximum suppression is handled internally by the model.</p>
                            <p>Each frame is rendered from an OpenCV Mat into an offscreen canvas, which TF.js reads via WebGL textures. The inference call is <code>await model.detect(canvas)</code> and the returned array is buffered so the draw loop can overlay the results on every subsequent frame until the next inference completes.</p>
                            break;

                        case "faceDetect":
                            <p>Uses the Viola-Jones Haar cascade classifier from the 2001 paper by Paul Viola and Michael Jones. It was the first practical real-time face detector and remains in use for its speed on CPU hardware.</p>
                            <p><strong>Integral image.</strong> A summed-area table is precomputed over the grayscale frame. Any rectangular region sum can then be computed in O(1) time with four table lookups: <code>sum(rect) = I(x2,y2) - I(x1,y2) - I(x2,y1) + I(x1,y1)</code>. This is what makes the feature evaluations cheap enough to run in real time.</p>
                            <p><strong>Haar-like features.</strong> Rectangular filters compute differences between adjacent region sums, which are fast approximations of edges, lines, and center-surround patterns. With the integral image, each feature evaluation costs O(1) regardless of the rectangle size. The full candidate set contains tens of thousands of features at various scales and positions within a sliding detection window.</p>
                            <p><strong>AdaBoost training.</strong> The cascade was trained offline by running AdaBoost to select the most discriminative subset of Haar features. Each boosting round picks one weak classifier (a single thresholded feature), and the weighted combination of those forms a strong classifier for one stage. The full cascade has around 20 stages, with later stages testing more features and being proportionally slower.</p>
                            <p><strong>Cascade rejection.</strong> Stages run in order from simplest to most complex. A window advances only if it passes the current stage; failing any stage discards it immediately. In practice roughly half of all non-face windows are rejected at stage one, which tests only the single best feature. Since most image regions are not faces, the average cost per window stays very low despite the total number of features.</p>
                            <p><code>scaleFactor</code> controls how much the detection window grows between pyramid levels (1.1 means 10% per step; smaller values are more thorough but require more passes). <code>minNeighbors</code> requires a candidate to be confirmed by N overlapping detections from neighboring windows before being accepted, trading recall for fewer false positives. The cascade loaded here was trained on frontal face data, so profile faces and extreme head angles are generally not detected.</p>
                            break;

                        case "opticalFlow":
                            <p>Dense optical flow estimates the per-pixel motion vector field between two consecutive frames. This implementation uses the Farneback algorithm, which fits a polynomial to the local intensity structure and tracks how that polynomial shifts from one frame to the next.</p>
                            <p>The output is rendered as a hue-saturation-value image where hue encodes motion direction and brightness encodes motion magnitude. A pixel moving fast toward the right appears as a bright pure-red point; stationary regions are black. Direction comes from <code>cartToPolar</code> applied to the two-channel flow field, with the angle scaled to the 0-179 OpenCV hue range. Normalized magnitude goes into the V channel.</p>
                            <p>The pyramid parameters control the scale-space search. At each level the image is downsampled by <code>pyrScale</code>, making it possible to track large displacements that are invisible at full resolution. Window Size sets the local averaging radius for the polynomial fitting step. Larger windows are more noise-robust but blur out fine motion boundaries. More Iterations improve accuracy at each level at the cost of per-frame processing time.</p>
                            break;

                        case "frameDiff":
                            <p>Computes the absolute per-pixel difference between the current frame and the previous one, then thresholds that difference to produce a binary motion mask. Pixels that changed by more than the threshold are classified as moving and tinted green; everything else shows the original image.</p>
                            <p>A Gaussian pre-blur is applied before differencing to suppress high-frequency noise and camera sensor grain that would otherwise produce a speckled mask on scenes with no real motion. The blur kernel must be odd; even values are automatically incremented to the next odd number.</p>
                            <p>Dilation expands detected regions outward using an elliptical structuring element, merging nearby blobs into solid contiguous areas. This is useful when a moving object produces a patchy mask because parts of it match the background color or have low texture contrast relative to the threshold.</p>
                            break;

                        case "bgSubtract":
                            <p>Background subtraction using the MOG2 (Mixture of Gaussians 2) model. Each pixel's intensity history is modeled as a mixture of Gaussians. After a warm-up period, pixels that fall outside their learned distribution are classified as foreground (green tint); stable background pixels are darkened.</p>
                            <p>MOG2 adapts continuously, so a stationary object that enters the scene will eventually be absorbed into the background model. The History slider controls how many frames contribute to this model. Fewer frames mean faster adaptation to scene changes but more false detections during camera motion or gradual lighting shifts.</p>
                            <p>Shadow detection is a separate classification step. Pixels that are darker than the background model but preserve the same relative color distribution are labeled as shadows (blue tint) rather than foreground. Disabling it reduces false positives in high-contrast lighting but may cause cast shadows to bleed into the foreground mask.</p>
                            break;

                        case "bgBlur":
                            <p>Combines background subtraction with Gaussian blur to produce a real-time depth-of-field effect similar to video conferencing portrait mode. The foreground is kept sharp while everything behind it is defocused.</p>
                            <p>A per-pixel exponential moving average tracks the background over time. Any pixel whose color deviates from its model by more than the Sensitivity threshold is classified as foreground. History controls how many frames contribute to the model. Fewer frames adapt faster to lighting changes; more frames give a more stable estimate in static scenes.</p>
                            <p>Before compositing, the binary foreground mask is blurred with a Gaussian to feather its edges. This avoids a hard cutout look by creating a smooth transition zone between sharp foreground and blurred background. The final output blends the original frame with the Gaussian-blurred version using the soft mask as a per-pixel alpha.</p>
                            break;

                        case "portraitBlur":
                            <p>Uses MediaPipe Selfie Segmentation to classify each pixel as person or background from a single frame — no background model or warm-up time required. The segmentation model was trained on large datasets of people and recognizes the person silhouette directly, which is how tools like Google Meet handle portrait blur.</p>
                            <p>Inference runs asynchronously so the video feed stays smooth. The model outputs a confidence mask (0-1 per pixel, 1 = person). That mask is feathered with a Gaussian blur before compositing, creating a gradual transition at the person's edges rather than a hard cutout. The background receives a Gaussian blur at the specified strength, while the foreground region shows the original sharp frame.</p>
                            <p>Compared to the Background Blur algorithm, this approach works instantly and handles any background without needing to learn it. The tradeoff is a model download on first use and slightly higher per-frame GPU cost. Feather controls the blend zone width at the silhouette boundary.</p>
                            break;

                        case "houghLines":
                            <p>The probabilistic Hough transform detects straight line segments by voting in a 2D accumulator space parameterized by angle and perpendicular distance from the origin. Each edge pixel votes for all lines it could belong to; accumulator bins with enough votes are declared line candidates, then extended into pixel-coordinate segments.</p>
                            <p>The input is a Canny edge map computed with fixed thresholds (50/150). Detected segments are drawn in neon green over the original frame. Vote Threshold controls how many edge pixels must support a line for it to be retained. Lower values produce more detections but also more noise, particularly on textured surfaces.</p>
                            <p>Min Length and Max Gap are specific to the probabilistic variant (<code>HoughLinesP</code>). Min Length discards short fragments. Max Gap allows separate collinear segments to be merged if the gap between them is small enough, which is useful for detecting dashed or interrupted lines such as road markings.</p>
                            break;

                        case "houghCircles":
                            <p>Detects circles using the gradient-based Hough circle transform, which works in two stages. First, a Canny edge map is computed internally. Then each edge pixel votes in a 2D accumulator for the set of circle centers consistent with its gradient direction. Accumulator peaks become center candidates, and each center is then matched to a radius.</p>
                            <p>A 9x9 Gaussian pre-blur is applied before detection to reduce false positives from noise and sharp pixel-level artifacts. Edge Sensitivity (param1) is the Canny high threshold passed to the internal edge detector. Centre Threshold (param2) is the accumulator vote count needed to declare a center. Lowering it finds more circles at the cost of more false positives.</p>
                            <p>Min and Max Radius constrain the search to a range of circle sizes, which both improves accuracy and reduces computation by skipping implausible radii. Setting both to 0 removes all size constraints. Detected circles are drawn with a neon green ring and an orange center dot to distinguish the estimated center from the circumference.</p>
                            break;

                        case "harrisCorner":
                            <p>Corner detection based on the structure tensor (second-moment matrix) of the local gradient. For each pixel, the gradient covariance matrix M is computed over a Block Size neighborhood using Sobel derivatives of aperture Sobel Size. The Harris response <code>R = det(M) - k * trace(M)^2</code> measures how much the local patch varies in multiple directions simultaneously.</p>
                            <p>Pixels with R above the threshold are corners. The response map is normalized to 0-255 before thresholding so that the slider value is scene-independent. Corners are marked with small neon green circles. Edges produce moderate R values; flat regions produce values near zero; true corners produce the highest values.</p>
                            <p>The Harris k parameter governs the trade-off between corner and edge responses. Typical values are 0.04 to 0.06. At lower values the detector is more sensitive but also reports more edge points as corners. Sobel Size must be odd; even values are incremented automatically. Larger values capture coarser-scale gradient structure at the cost of spatial precision.</p>
                            break;

                        case "pencilSketch":
                            <p>Produces a pencil drawing effect using the dodge-blend technique from digital photo editing. The grayscale frame is inverted, blurred, and then divided into the original grayscale. This locally amplifies intensity where the blurred inverse is light (no dark edges nearby) and compresses it where it is dark (edges are present).</p>
                            <p>Stroke Size controls the blur kernel applied to the inverted image. Larger values produce wider, bolder pencil strokes. Softness (sigma) is the Gaussian standard deviation for that blur; at 0 it is derived from the kernel size automatically. Invert flips the output palette to give white strokes on a black background rather than dark strokes on white.</p>
                            <p>The Colors parameter adds posterized color from the original frame. A lookup table maps the live image to N discrete color levels, and the sketch grayscale value multiplies each color channel as a transparency mask. At Colors=1 the output is pure grayscale. Higher values progressively reveal the original hues wherever the paper is not darkened by pencil strokes.</p>
                            break;

                        case "pixelate":
                            <p>Downsamples the image to a coarse grid and then upsamples back to the original size using nearest-neighbor interpolation. Because nearest-neighbor copies pixel values without blending, each original pixel is assigned the color of the grid block it falls into, producing the characteristic mosaic appearance.</p>
                            <p>Block Size controls the coarseness: a value of 16 means each output block represents a 16x16 region averaged to one color. Larger values give a more retro low-resolution look. The implementation uses two <code>cv.resize</code> calls: a downscale to compute block averages via area averaging, and an upscale with <code>INTER_NEAREST</code> to reproduce the blocky output without any smoothing.</p>
                            <p>The Saturation multiplier is applied in HSV space before pixelation. Values above 1 boost color vibrancy; below 1 fade toward grayscale. At exactly 1.0 the saturation step is skipped entirely to avoid the colorspace round-trip cost.</p>
                            break;

                        case "cartoon":
                            <p>Combines bilateral filtering for flat-color regions with adaptive edge detection to produce a cartoon or comic-book style. The bilateral filter smooths texture while preserving hard color boundaries, because it weights pixel contributions by both spatial distance and color similarity simultaneously.</p>
                            <p>Smooth Passes applies the bilateral filter repeatedly. Each pass further flattens mid-frequency texture while leaving sharp transitions intact. Color Range (sigmaColor) sets how different two pixels' colors can be and still influence each other. Larger values blend more aggressively across color boundaries, producing wider flat regions at the cost of bleeding at sharp edges.</p>
                            <p>The edge layer is computed via adaptive thresholding on a median-blurred grayscale image. Adaptive thresholding computes a per-pixel threshold from a local neighborhood mean, making it robust to non-uniform lighting. Edge Block is the neighborhood size for this step; Edge Offset is the constant subtracted from the local mean to sharpen or soften what counts as an edge. The binary mask is ANDed with the smoothed color image to overlay dark outlines.</p>
                            break;

                        case "kaleidoscope":
                            <p>Takes the top-left quadrant of each frame and mirrors it horizontally, vertically, and diagonally to fill all four quadrants. The result is a perfectly tiled four-fold symmetry that updates every frame in real time. The Rotation slider feeds the frame through <code>warpAffine</code> with <code>BORDER_REFLECT</code> padding before the quadrant is extracted, which rotates the symmetry axis without introducing black corners at extreme angles.</p>
                            <p>The mirror step is computed as a single typed-array pass over the pixel buffer. For each pixel at position <code>(r, c)</code> in the top-left quadrant, three destination coordinates are computed analytically: <code>(r, W-1-c)</code> for the horizontal mirror, <code>(H-1-r, c)</code> for the vertical mirror, and <code>(H-1-r, W-1-c)</code> for the diagonal mirror. All four channels (RGBA) are written simultaneously. This keeps the per-frame cost proportional to one quarter of the image area regardless of image content.</p>
                            break;

                        case "asciiArt":
                            <p>Divides the frame into a grid of square cells and maps each cell to a single character from the density ramp <code>' .:-=+*#%@@'</code>. Character selection uses the ITU-R BT.601 luma formula <code>Y = 0.299R + 0.587G + 0.114B</code> on the center pixel of each cell, then linearly maps the result to one of the ten characters: space for near-black, <code>@@</code> for near-white. Cell Size controls the grid resolution. A value of 8 on a 640x480 frame produces an 80x60 character grid, similar to the resolution of a classic VT100 terminal.</p>
                            <p>Characters are rendered onto an offscreen HTML canvas using the browser's 2D drawing API with a bold monospace font sized to match the cell grid. In Color mode each character inherits the original pixel's RGB value; in grayscale mode it uses the computed luminance. The finished canvas is read back into an OpenCV Mat via <code>cv.imread</code> and passed through the display pipeline. The offscreen canvas is cached and only reallocated when the frame resolution changes.</p>
                            break;

                        case "nightVision":
                            <p>Converts each frame to grayscale and amplifies the luminance by the Green Amp factor, then remaps the result to a green phosphor palette: the red channel is set to 10% of the value, the blue channel to 15%, and the green channel to the full amplified value. This approximates the spectral response of a Generation 2 image intensifier tube, where the photocathode output drives a green phosphor screen rather than a color display.</p>
                            <p>Grain adds per-pixel offsets drawn from a zero-mean uniform distribution scaled by the Grain slider, simulating the shot noise characteristic of low-light sensors. Vignette multiplies each pixel value by <code>max(0, 1 - k * d^2 / dmax^2)</code>, where <code>d</code> is the distance from the frame center and <code>dmax</code> is the corner distance. Both effects are computed in the same pixel loop as the amplification and color tinting, so the total cost is a single pass over the image regardless of how many effects are active.</p>
                            break;
                    }
                </div>
            </div>
        </div>

        <!-- Center: Main Screen -->
        <div class="cv-main">
            @if (!_ready)
            {
                <div class="cv-loader">
                    <i class="fa-solid fa-camera cv-loader-icon"></i>
                    <h3>Computer Vision Playground</h3>
                    <p>@_statusMsg</p>

                    @if (_isLoading)
                    {
                        <div class="cv-load-progress"
                             role="progressbar"
                             aria-label="Algorithm loading progress"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuenow="@LoadPercent">
                            <span style="width: @(LoadPercent)%"></span>
                        </div>
                        <div class="cv-load-count">@_loadCompleted / @_loadTotal &middot; @LoadPercent%</div>
                    }
                    else
                    {
                        <button class="cv-load-btn" @onclick="LoadAndStartAsync">
                            <i class="fa-solid fa-download"></i>
                            @(_loadFailed ? "Retry loading" : "Load algorithms")
                        </button>
                    }

                    <a class="cv-licenses-link" href="cv/licenses">Third-party licenses</a>
                </div>
            }
            <video @ref="_videoRef" autoplay playsinline muted style="display:none"></video>
            <canvas @ref="_canvasRef"
                    class="cv-canvas @(_ready ? "visible" : "") @(_eyedropperMode ? "eyedropper" : "")"
                    @onclick="OnCanvasClick"></canvas>
            @if (_captureMode)
            {
                <div class="capture-overlay"
                     @onmousedown="OnCaptureMouseDown"
                     @onmousemove="OnCaptureMouseMove"
                     @onmouseup="OnCaptureMouseUp">
                    @if (_isDragging)
                    {
                        <div class="capture-selection" style="@CaptureSelectionStyle"></div>
                    }
                </div>
            }
        </div>

        <!-- Right: Controls -->
        <div class="cv-panel cv-controls">
            <div class="panel-label">Sliders</div>

            <div class="sliders">
                @if (_selected.Params.Count == 0)
                {
                    <span class="no-params">No parameters</span>
                }
                @foreach (var p in _selected.Params)
                {
                    var param = p;
                    <div class="slider-group @(_openInfo == param.Id ? "info-open" : "")">
                        @if (!param.IsCheckbox)
                        {
                            <div class="slider-header">
                                <span class="slider-label">@param.Label</span>
                                <div class="slider-header-right">
                                    <span class="slider-value">@param.DisplayValue</span>
                                    @if (!string.IsNullOrEmpty(param.Description))
                                    {
                                        <button class="info-btn"
                                                title="@param.Description"
                                                @onclick="() => ToggleInfo(param.Id)"
                                                aria-label="Info about @param.Label">i</button>
                                    }
                                </div>
                            </div>
                        }
                        @if (param.IsCheckbox)
                        {
                            <label class="option-check" style="padding-top:0.1rem">
                                <input type="checkbox"
                                       checked="@(param.Value >= 1)"
                                       @onchange="e => OnCheckboxParamChange(param, e)" />
                                @param.Label
                            </label>
                        }
                        else
                        {
                            var _sliderDisabled = _selected.Id == "kaleidoscope"
                                && param.Id == "speed"
                                && (_selected.Params.FirstOrDefault(x => x.Id == "cycle")?.Value ?? 0) < 1;
                            <input type="range"
                                   min="@param.Min.ToString("0.##")"
                                   max="@param.Max.ToString("0.##")"
                                   step="@param.Step.ToString("0.##")"
                                   value="@param.Value.ToString("0.##")"
                                   disabled="@_sliderDisabled"
                                   @oninput="e => OnParamChange(param, e)" />
                        }
                        @if (!string.IsNullOrEmpty(param.Description))
                        {
                            <div class="slider-desc">@param.Description</div>
                        }
                    </div>
                }
            </div>

            @if (_selected.Id == "colorDetect")
            {
                <div class="color-picker-section">
                    <div class="color-picker-row">
                        <div class="color-swatch" style="background: rgb(@_colorR, @_colorG, @_colorB)"></div>
                        <input type="color"
                               value="@ColorHex"
                               @oninput="OnColorInputChange"
                               title="Open color picker" />
                        <button class="eyedropper-btn @(_eyedropperMode ? "active" : "")"
                                title="@(_eyedropperMode ? "Cancel — click image to sample" : "Sample color from image")"
                                @onclick="ToggleEyedropper">
                            <i class="fa-solid fa-eye-dropper"></i>
                        </button>
                    </div>
                    @if (_eyedropperMode)
                    {
                        <div class="eyedropper-hint">Image frozen. Click any pixel to sample its color.</div>
                    }
                </div>
            }

            @if (_selected.Id == "objectDetect")
            {
                <div class="capture-section">
                    <div class="capture-controls">
                        <button class="capture-btn @(_captureMode ? "active" : "")"
                                @onclick="ToggleCaptureMode">
                            @(_captureMode ? "Cancel" : _hasTemplate ? "Re-Capture" : "Capture Object")
                        </button>
                        @if (_hasTemplate && !_captureMode)
                        {
                            <button class="capture-clear-btn" title="Clear template" @onclick="ClearTemplate">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        }
                    </div>
                    <div class="capture-hint">
                        @if (_captureMode)
                        {
                            <span>Drag a box around the object to track.</span>
                        }
                        else if (!_hasTemplate)
                        {
                            <span>Capture a region to start tracking it in the feed.</span>
                        }
                    </div>
                </div>
            }

            <div class="cv-options">
                <label class="option-check">
                    <input type="checkbox" @bind="_mirror" @bind:after="OnMirrorChange" />
                    Mirror
                </label>
                <label class="option-check">
                    <input type="checkbox" @bind="_paused" @bind:after="OnPauseChange" />
                    Pause
                </label>
                <label class="option-check">
                    <input type="checkbox" @bind="_showFps" @bind:after="OnShowFpsChange" />
                    Show FPS
                </label>
            </div>
        </div>

    </div>
</div>

@code {
