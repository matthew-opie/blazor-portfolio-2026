    // ── Algorithm tags ────────────────────────────────────────────────────────

    static readonly Dictionary<string, string[]> _tags = new()
    {
        ["passthrough"]   = ["opencv"],
        ["grayscale"]     = ["opencv"],
        ["invert"]        = ["opencv"],
        ["blur"]          = ["opencv"],
        ["threshold"]     = ["opencv"],
        ["canny"]         = ["opencv"],
        ["houghLines"]    = ["opencv"],
        ["houghCircles"]  = ["opencv"],
        ["harrisCorner"]  = ["opencv"],
        ["colorDetect"]   = ["opencv"],
        ["objectDetect"]  = ["opencv"],
        ["handTrack"]     = ["tensorflow", "mediapipe"],
        ["poseEstimate"]  = ["tensorflow"],
        ["cocoSsd"]       = ["tensorflow"],
        ["faceDetect"]    = ["opencv"],
        ["faceLandmarks"] = ["tensorflow", "mediapipe"],
        ["bodySegment"]   = ["tensorflow"],
        ["depthEstimate"] = ["tensorflow"],
        ["emotionDetect"] = ["tensorflow"],
        ["opticalFlow"]   = ["opencv"],
        ["frameDiff"]     = ["opencv"],
        ["bgSubtract"]    = ["opencv"],
        ["bgBlur"]        = ["opencv"],
        ["portraitBlur"]  = ["mediapipe"],
        ["pencilSketch"]  = ["opencv"],
        ["pixelate"]      = ["opencv"],
        ["cartoon"]       = ["opencv"],
        ["kaleidoscope"]  = ["opencv"],
        ["asciiArt"]      = ["opencv"],
        ["nightVision"]   = ["opencv"],
    };

    // ── State ─────────────────────────────────────────────────────────────────

    ElementReference _videoRef;
    ElementReference _canvasRef;

    AlgorithmDef _selected       = _algorithms[0];
    bool         _mirror         = true;
    bool         _paused         = false;
    bool         _showFps        = false;
    bool         _ready          = false;
    bool         _isLoading      = false;
    bool         _loadFailed     = false;
    int          _loadCompleted  = 0;
    int          _loadTotal      = 0;
    string?      _statusMsg      = "Download and prepare every algorithm before enabling the camera.";
    string?      _openInfo       = null;
    bool         _eyedropperMode = false;
    bool         _infoOpen      = false;
    string?      _activeTagFilter = null;
    bool         _captureMode   = false;
    bool         _isDragging    = false;
    bool         _hasTemplate   = false;
    double       _dragOffX1, _dragOffY1, _dragOffX2, _dragOffY2; // overlay-relative (for visual rect)
    double       _dragClientX1, _dragClientY1;                    // client coords (for JS crop)
    int          _colorR         = 255;
    int          _colorG         = 0;
    int          _colorB         = 0;
    DotNetObjectReference<CompVision>? _progressRef;

    string ColorHex => $"#{_colorR:X2}{_colorG:X2}{_colorB:X2}";
    int LoadPercent => _loadTotal == 0
        ? 0
        : (int)Math.Round(_loadCompleted * 100.0 / _loadTotal);

    string CaptureSelectionStyle =>
        $"left:{Math.Min(_dragOffX1,_dragOffX2):0}px;" +
        $"top:{Math.Min(_dragOffY1,_dragOffY2):0}px;" +
        $"width:{Math.Abs(_dragOffX2-_dragOffX1):0}px;" +
        $"height:{Math.Abs(_dragOffY2-_dragOffY1):0}px;";

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task OnPreloadProgress(int completed, int total, string message)
    {
        _loadCompleted = completed;
        _loadTotal     = total;
        _statusMsg     = message;
        await InvokeAsync(StateHasChanged);
    }

    async Task LoadAndStartAsync()
    {
        if (_isLoading) return;

        _isLoading     = true;
        _loadFailed    = false;
        _loadCompleted = 0;
        _loadTotal     = 0;
        _statusMsg     = "Preparing downloads\u2026";
        StateHasChanged();

        try
        {
            _progressRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("cvEngine.preload", _progressRef);

            _statusMsg = "Algorithms ready. Requesting camera access\u2026";
            StateHasChanged();

            await JS.InvokeVoidAsync("cvEngine.init", _videoRef, _canvasRef);
            await JS.InvokeVoidAsync("cvEngine.setMirror", _mirror);
            _ready     = true;
            _statusMsg = null;
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            _statusMsg  = $"Loading failed: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("cvEngine.stop"); }
        catch { /* component may be disposed before JS is ready */ }
        _progressRef?.Dispose();
    }

    // ── Event handlers ────────────────────────────────────────────────────────

    async Task SelectAlgorithm(AlgorithmDef algo)
    {
        _selected       = algo;
        _openInfo       = null;
        _eyedropperMode = false;
        _captureMode    = false;
        _isDragging     = false;
        if (_paused) { _paused = false; await JS.InvokeVoidAsync("cvEngine.setPause", false); }

        var paramDict = algo.Params.ToDictionary(p => p.Id, p => p.Value);
        if (algo.Id == "colorDetect")
        {
            paramDict["r"] = _colorR;
            paramDict["g"] = _colorG;
            paramDict["b"] = _colorB;
        }
        await JS.InvokeVoidAsync("cvEngine.setAlgorithm", algo.Id, paramDict);
    }

    void ToggleInfo(string id) => _openInfo = _openInfo == id ? null : id;

    void ToggleTagFilter(string tag) =>
        _activeTagFilter = _activeTagFilter == tag ? null : tag;

    async Task ToggleEyedropper()
    {
        _eyedropperMode = !_eyedropperMode;
        _paused         = _eyedropperMode;
        if (_eyedropperMode)
            await JS.InvokeVoidAsync("cvEngine.freezePassthrough");
        else
            await JS.InvokeVoidAsync("cvEngine.setPause", false);
    }

    async Task OnCanvasClick(MouseEventArgs e)
    {
        if (!_eyedropperMode) return;
        var color = await JS.InvokeAsync<int[]?>("cvEngine.pickColorAt", e.ClientX, e.ClientY);
        if (color is { Length: 3 })
        {
            _colorR = color[0];
            _colorG = color[1];
            _colorB = color[2];
            await PushColor();
        }
        _eyedropperMode = false;
        _paused         = false;
        await JS.InvokeVoidAsync("cvEngine.setPause", false);
    }

    async Task OnColorInputChange(ChangeEventArgs e)
    {
        var hex = e.Value?.ToString()?.TrimStart('#');
        if (hex?.Length == 6)
        {
            _colorR = Convert.ToInt32(hex[..2], 16);
            _colorG = Convert.ToInt32(hex[2..4], 16);
            _colorB = Convert.ToInt32(hex[4..6], 16);
            await PushColor();
        }
    }

    async Task PushColor()
    {
        await JS.InvokeVoidAsync("cvEngine.setParam", "r", (double)_colorR);
        await JS.InvokeVoidAsync("cvEngine.setParam", "g", (double)_colorG);
        await JS.InvokeVoidAsync("cvEngine.setParam", "b", (double)_colorB);
    }

    async Task OnParamChange(AlgoParam param, ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var val)) return;
        param.Value = val;
        await JS.InvokeVoidAsync("cvEngine.setParam", param.Id, val);
    }

    async Task OnCheckboxParamChange(AlgoParam param, ChangeEventArgs e)
    {
        param.Value = e.Value is true ? 1 : 0;
        await JS.InvokeVoidAsync("cvEngine.setParam", param.Id, param.Value);
    }

    async Task OnMirrorChange()  => await JS.InvokeVoidAsync("cvEngine.setMirror",  _mirror);
    async Task OnPauseChange()   => await JS.InvokeVoidAsync("cvEngine.setPause",   _paused);
    async Task OnShowFpsChange() => await JS.InvokeVoidAsync("cvEngine.setShowFps", _showFps);

    async Task ToggleCaptureMode()
    {
        _captureMode = !_captureMode;
        _isDragging  = false;
        if (_captureMode)
            await JS.InvokeVoidAsync("cvEngine.freezePassthrough");
        else
        {
            _paused = false;
            await JS.InvokeVoidAsync("cvEngine.setPause", false);
        }
    }

    async Task ClearTemplate()
    {
        _hasTemplate = false;
        await JS.InvokeVoidAsync("cvEngine.clearObjectTemplate");
    }

    void OnCaptureMouseDown(MouseEventArgs e)
    {
        _isDragging   = true;
        _dragOffX1    = _dragOffX2    = e.OffsetX;
        _dragOffY1    = _dragOffY2    = e.OffsetY;
        _dragClientX1 = e.ClientX;
        _dragClientY1 = e.ClientY;
    }

    void OnCaptureMouseMove(MouseEventArgs e)
    {
        if (!_isDragging) return;
        _dragOffX2 = e.OffsetX;
        _dragOffY2 = e.OffsetY;
    }

    async Task OnCaptureMouseUp(MouseEventArgs e)
    {
        if (!_isDragging) return;
        _isDragging = false;

        var ok = await JS.InvokeAsync<bool>("cvEngine.setObjectTemplate",
            _dragClientX1, _dragClientY1, e.ClientX, e.ClientY);
        if (ok)
        {
            _hasTemplate = true;
            _captureMode = false;
            _paused      = false;
            await JS.InvokeVoidAsync("cvEngine.setPause", false);
        }
    }
}
